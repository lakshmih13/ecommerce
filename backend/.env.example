# Copy this file to .env and fill in your own values
PORT=5000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password
PGDATABASE=codveda_ecommerce

# JWT
# Use a long random string in real deployments (e.g. openssl rand -hex 32)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
